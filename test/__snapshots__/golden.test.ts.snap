{
  "forbidden": [
    ".env*",
    "**/secrets.*"
  ],
  "agents": {
    "backend-builder": [
      "src/server/**"
    ],
    "frontend-builder": [
      "src/ui/**"
    ],
    "test-verifier": [
      "tests/acceptance/**"
    ],
    "migration-author": [
      "db/migrations/**"
    ],
    "devops-builder": [
