}

===== .claude/settings.json =====
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \\"$CLAUDE_PROJECT_DIR/.claude/hooks/factory-guard.mjs\\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.env*)",
      "Edit(**/secrets.*)"
    ]
  }
}

